<section>
  <h1>Hello world</h1>
</section>

<style>
  .announcement-bar {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }
</style>
{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "banner"
    }
  ]
}
{% endschema %}
